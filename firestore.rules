rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDj(setId) {
      return request.auth != null
        && request.auth.uid == get(/databases/$(database)/documents/sets/$(setId)).data.djId;
    }

    function setDoc(setId) {
      return get(/databases/$(database)/documents/sets/$(setId)).data;
    }

    function setNotEnded(setId) {
      let set = setDoc(setId);
      return set.status != 'ended'
        && request.time < set.startAt + duration.value(set.durationMinutes, 'm');
    }

    function validBallotSongIds(songIds) {
      return songIds is list && songIds.size() <= 50;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    match /djSlugs/{djSlug} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /sets/{setId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.djId == request.auth.uid;
      allow update, delete: if isDj(setId);

      match /ballots/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || isDj(setId));
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && setNotEnded(setId)
          && request.resource.data.keys().hasOnly(['songIds'])
          && validBallotSongIds(request.resource.data.songIds);
        allow delete: if request.auth != null
          && request.auth.uid == uid
          && setNotEnded(setId);
      }

      match /songs/{songId} {
        allow read: if true;
        allow create, update, delete: if isDj(setId);

        match /shards/{shardId} {
          allow read, write: if false;
        }

        match /votes/{voterId} {
          allow read, write: if false;
        }
      }
    }
  }
}
